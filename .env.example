# Sem estas variáveis o CRM roda em "modo demonstração" (dados só no navegador).
# Com elas, usa login, organizações e banco Supabase com RLS.
# Use SOMENTE a URL e a chave pública (anon/publishable). NUNCA coloque a service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Formulário público (/f/<slug> e /api/public-lead) ----------
# Cloudflare Turnstile. A chave do site é pública; a SECRETA fica só no servidor (sem NEXT_PUBLIC).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcional: domínios em que o widget pode ser resolvido (ex.: crm.axbiinteligencia.com.br axbiinteligencia.com.br)
TURNSTILE_ALLOWED_HOSTNAMES=
# Segredo do servidor (mínimo 32 caracteres, aleatório). O banco guarda só o SHA-256 dele (crm_private.settings).
# Também é a chave do HMAC que pseudonimiza o IP. Gere com: openssl rand -hex 32
CRM_FORM_GATEWAY_SECRET=
# Origens exatas que podem incorporar o formulário e enviar para /api/public-lead (sem curingas).
EMBED_ALLOWED_ORIGINS=https://axbiinteligencia.com.br https://www.axbiinteligencia.com.br
